RewriteEngine On

<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Browser Note
RewriteRule ^browser-note/?$ https://bendodson.com/apps/browser-note/ [R=301,NC,L]
RewriteRule ^browser-note/index\.html$ https://bendodson.com/apps/browser-note/ [R=301,NC,L]
RewriteRule ^browser-note/support/?$ https://bendodson.com/apps/browser-note/support/ [R=301,NC,L]
RewriteRule ^browser-note/support/index\.html$ https://bendodson.com/apps/browser-note/support/ [R=301,NC,L]
RewriteRule ^browser-note/privacy/?$ https://bendodson.com/apps/browser-note/privacy-policy/ [R=301,NC,L]
RewriteRule ^browser-note/privacy/index\.html$ https://bendodson.com/apps/browser-note/privacy-policy/ [R=301,NC,L]
RewriteRule ^browser-note/privacy-policy/?$ https://bendodson.com/apps/browser-note/privacy-policy/ [R=301,NC,L]

# Chaise Longue to 5K
RewriteRule ^chaise-longue-to-5k/?$ https://bendodson.com/apps/chaise-longue-to-5k/ [R=301,NC,L]
RewriteRule ^chaise-longue-to-5k/index\.html$ https://bendodson.com/apps/chaise-longue-to-5k/ [R=301,NC,L]
RewriteRule ^chaise-longue-to-5k/support/?$ https://bendodson.com/apps/chaise-longue-to-5k/support/ [R=301,NC,L]
RewriteRule ^chaise-longue-to-5k/support/index\.html$ https://bendodson.com/apps/chaise-longue-to-5k/support/ [R=301,NC,L]
RewriteRule ^chaise-longue-to-5k/privacy/?$ https://bendodson.com/apps/chaise-longue-to-5k/privacy-policy/ [R=301,NC,L]
RewriteRule ^chaise-longue-to-5k/privacy/index\.html$ https://bendodson.com/apps/chaise-longue-to-5k/privacy-policy/ [R=301,NC,L]
RewriteRule ^chaise-longue-to-5k/privacy-policy/?$ https://bendodson.com/apps/chaise-longue-to-5k/privacy-policy/ [R=301,NC,L]
RewriteRule ^chaise-longue-to-5k/media-kit/?$ https://bendodson.com/apps/chaise-longue-to-5k/ [R=301,NC,L]
RewriteRule ^chaise-longue-to-5k/media-kit/index\.html$ https://bendodson.com/apps/chaise-longue-to-5k/ [R=301,NC,L]

