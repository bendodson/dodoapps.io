# Return to Dark Tower Assistant
RewriteRule ^return-to-dark-tower-assistant/?$ https://bendodson.com/apps/return-to-dark-tower-assistant/ [R=301,NC,L]
RewriteRule ^return-to-dark-tower-assistant/index\.html$ https://bendodson.com/apps/return-to-dark-tower-assistant/ [R=301,NC,L]
RewriteRule ^return-to-dark-tower-assistant/support/?$ https://bendodson.com/apps/return-to-dark-tower-assistant/support/ [R=301,NC,L]
RewriteRule ^return-to-dark-tower-assistant/support/index\.html$ https://bendodson.com/apps/return-to-dark-tower-assistant/support/ [R=301,NC,L]
RewriteRule ^return-to-dark-tower-assistant/privacy/?$ https://bendodson.com/apps/return-to-dark-tower-assistant/privacy-policy/ [R=301,NC,L]
RewriteRule ^return-to-dark-tower-assistant/privacy/index\.html$ https://bendodson.com/apps/return-to-dark-tower-assistant/privacy-policy/ [R=301,NC,L]
RewriteRule ^return-to-dark-tower-assistant/privacy-policy/?$ https://bendodson.com/apps/return-to-dark-tower-assistant/privacy-policy/ [R=301,NC,L]

# Everything else on the old Dodo Apps site now points to the apps index.
RewriteRule ^.*$ https://bendodson.com/apps/ [R=301,L]
