# Old Music Tracker slug
RewriteRule ^music-tracker/?$ https://bendodson.com/apps/music-library-tracker/ [R=301,NC,L]
RewriteRule ^music-tracker/index\.html$ https://bendodson.com/apps/music-library-tracker/ [R=301,NC,L]
RewriteRule ^music-tracker/support/?$ https://bendodson.com/apps/music-library-tracker/support/ [R=301,NC,L]
RewriteRule ^music-tracker/privacy/?$ https://bendodson.com/apps/music-library-tracker/privacy-policy/ [R=301,NC,L]
